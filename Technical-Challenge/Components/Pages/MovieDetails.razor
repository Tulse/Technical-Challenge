@page "/movies/{MovieId:int}"

<h3>Movie Details</h3>

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_errorMessage is not null)
{
    <p style="color: darkred;">@_errorMessage</p>
}
else if (_movie is not null)
{
    <h4>@_movie.Title</h4>

    @if (_movie.PosterUrl is not null)
    {
        <img src="@_movie.PosterUrl" style="max-width:200px;" />
    }

    <p><strong>Release:</strong> @_movie.ReleaseDate</p>
    <p><strong>Runtime:</strong> @_movie.RuntimeMinutes min</p>
    <p><strong>Rating:</strong> @_movie.Rating</p>

    <p>@_movie.Overview</p>

    <p><strong>Genres:</strong> @string.Join(", ", _movie.Genres)</p>
}
