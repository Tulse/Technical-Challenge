@page "/movies/{MovieId:int}"
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mx-0">

    <h3>Movie Details</h3>

    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               Color="Color.Primary"
               Class="mb-3"
               OnClick="GoBack">
        Back
    </MudButton>

    @if (_isLoading)
    {
        < MudProgressCircular Indeterminate = "true" Color = "Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_movie is not null)
    {
        <MudGrid GutterSize="3">
            <MudItem xs="12" sm="4" md="3">
                @if (_movie.PosterUrl is not null)
                {
                    <MudPaper Elevation="2" Class="pa-2">
                        <MudImage Src="@_movie.PosterUrl"
                                  Alt="@_movie.Title"
                                  Style="width:100%; height:auto;"
                                  ObjectFit="ObjectFit.Contain" />
                    </MudPaper>
                }
            </MudItem>

            <MudItem xs="12" sm="8" md="9">

                <MudText Typo="Typo.h4">@_movie.Title</MudText>

                <MudText Typo="Typo.subtitle1" Class="mt-1">
                    Rating: @_movie.Rating
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_movie.ReleaseDate))
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-3">
                        Released: @_movie.ReleaseDate
                    </MudText>
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.body1">
                    @_movie.Overview
                </MudText>

            </MudItem>
        </MudGrid>
    }
</MudContainer>
