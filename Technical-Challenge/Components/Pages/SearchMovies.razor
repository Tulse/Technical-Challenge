@namespace Technical_Challenge.Components.Pages
@page "/movies/search"
@inject NavigationManager Navigation
@using Models

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mx-0">

    <MudText Typo="Typo.h4" GutterBottom="true">
        Search Movies
    </MudText>

    <!-- Search Bar -->
    <MudPaper Class="pa-3 mb-1" Elevation="0">
        <MudGrid GutterSize="2" AlignItems="AlignItems.Center">

            <MudItem xs="12" sm="9" md="10">
                <MudTextField @bind-Value="_query"
                              Label="Search"
                              Placeholder="Type to search…"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Dense="true" />
            </MudItem>

            <MudItem xs="12" sm="3" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="SearchAsync">
                    Search
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudPaper>

    <!-- Filters -->
    <MudPaper Class="pt-2 pb-3 px-3 mb-3" Elevation="0">
        <MudGrid GutterSize="2" AlignItems="AlignItems.Center">

            <!-- Min Rating -->
            <MudItem xs="12" md="6">
                <MudSlider @bind-Value="_minRating"
                           Min="0"
                           Max="10"
                           Step="0.5"
                           Immediate="true"
                           Color="Color.Primary">
                    <LabelTemplate>
                        Min rating: @_minRating
                    </LabelTemplate>
                </MudSlider>
            </MudItem>

            <!-- Release Year -->
            <MudItem xs="6" md="3">
                <MudNumericField T="int?"
                                 @bind-Value="_releaseYear"
                                 Label="Year"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Min="1900"
                                 Max="2100"
                                 Clearable="true" />
            </MudItem>

            <!-- Reset -->
            <MudItem xs="6" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           Disabled="!HasActiveFilters"
                           FullWidth="true"
                           OnClick="ResetFilters">
                    Reset Filters
                </MudButton>
            </MudItem>

        </MudGrid>
    </MudPaper>


    <!-- Results -->
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_hasSearched && _movies.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No results.
        </MudAlert>
    }
    else if (_movies.Count > 0)
    {
        <MudTable Items="FilteredMovies"
                  Hover="true"
                  Bordered="true"
                  Striped="true"
                  Dense="true">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.Title)">
                        Title
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.ReleaseDate)">
                        Release Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.Rating)">
                        Rating
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Release Date">@context.ReleaseDate</MudTd>
                <MudTd DataLabel="Rating">@context.Rating</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Navigation.NavigateTo($"/movies/{context.Id}"))">
                        View Details
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

</MudContainer>
