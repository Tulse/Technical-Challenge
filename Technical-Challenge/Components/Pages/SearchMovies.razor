@namespace Technical_Challenge.Components.Pages
@page "/movies/search"
@rendermode InteractiveServer

<h3>Search Movies</h3>

<div style="margin-bottom: 1rem;">
    <input @bind="_query" @bind:event="oninput" placeholder="Type to search…" style="width: 320px;" />
    <button @onclick="SearchAsync" style="margin-left: .5rem;">Search</button>
</div>

@if (_isLoading)
{
    <p>Loading…</p>
}
else if (_errorMessage is not null)
{
    <p style="color: darkred;">@_errorMessage</p>
}
else if (_hasSearched && _movies.Count == 0)
{
    <p>No results.</p>
}
else if (_movies.Count > 0)
{
    <ul>
        @foreach (var movie in _movies)
        {
            <li>
                <a href="/movies/@movie.Id">@movie.Title</a>
                @if (!string.IsNullOrWhiteSpace(movie.ReleaseDate))
                {
                    <span> (@movie.ReleaseDate)</span>
                }
                <span> — Rating: @movie.Rating</span>
            </li>
        }
    </ul>
}

@code {
    // This connects to SearchMovies.razor.cs
}