@namespace Technical_Challenge.Components.Pages
@page "/movies/search"
@inject NavigationManager Navigation
@using Models

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mx-0">

    <MudText Typo="Typo.h4" GutterBottom="true">
        Search Movies
    </MudText>

    <!-- Search Bar -->
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_query"
                          Label="Search"
                          Placeholder="Type to search…"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SearchAsync">
                Search
            </MudButton>
        </MudStack>
    </MudPaper>

    <!-- Filters -->
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudStack Spacing="3">

            <MudStack Direction="Row" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <MudText Typo="Typo.subtitle1">
                    Filters
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           Disabled="!HasActiveFilters"
                           OnClick="ResetFilters">
                    Reset filters
                </MudButton>
            </MudStack>

            <MudSlider @bind-Value="_minRating"
                       Min="0"
                       Max="10"
                       Step="0.5"
                       Color="Color.Primary"
                       Immediate="true">
                <LabelTemplate>
                    Minimum Rating: @_minRating
                </LabelTemplate>
            </MudSlider>

            <MudNumericField T="int?"
                             @bind-Value="_releaseYear"
                             Label="Release year"
                             Placeholder="e.g. 2005"
                             Min="1900"
                             Max="2100"
                             Clearable="true" />
        </MudStack>
    </MudPaper>

    <!-- Results -->
    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_hasSearched && _movies.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No results.
        </MudAlert>
    }
    else if (_movies.Count > 0)
    {
        <MudTable Items="FilteredMovies"
                  Hover="true"
                  Bordered="true"
                  Striped="true">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.Title)">
                        Title
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.ReleaseDate)">
                        Release Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="MovieSummary"
                                       SortBy="@(m => m.Rating)">
                        Rating
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Release Date">@context.ReleaseDate</MudTd>
                <MudTd DataLabel="Rating">@context.Rating</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Navigation.NavigateTo($"/movies/{context.Id}"))">
                        View Details
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

</MudContainer>
