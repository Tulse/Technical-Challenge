@page "/movies/discover"
@using Technical_Challenge.Models
@using Technical_Challenge.Services
@inject IMoviesApiClient MoviesApi

<h3>Top-Rated Movies (Virtualized)</h3>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else if (_movies?.Count > 0)
{
    <Virtualize Items="_movies" Context="movie" ItemSize="340">
        <MudPaper Class="ma-3 pa-3" Elevation="2">
            <div style="display:flex; gap:16px;">
                <MudImage Src="@movie.PosterUrl"
                    Alt="@movie.Title"
                    Width="160"
                    Height="240"
                    ObjectFit="ObjectFit.Cover" />
                <div>
                    <MudText Typo="Typo.h6">@movie.Title</MudText>
                    <MudText Typo="Typo.subtitle2">
                        Rating: @movie.Rating · @movie.ReleaseDate
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mt-2">
                        @(movie.Overview?.Length > 200
                            ? movie.Overview[..200] + "…"
                            : movie.Overview)
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </Virtualize>
}
else
{
    <p>No movies to display.</p>
}

@code {
    private List<Models.MovieDiscover> _movies = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _movies = await MoviesApi.DiscoverMoviesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load movies: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
